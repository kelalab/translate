{
  "name": "translate",
  "productName": "TranslateGemma",
  "version": "1.0.3",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-builder install-app-deps",
    "build:signed": "pwsh -NoProfile -File scripts/build-signed.ps1"
  },
  "keywords": [
    "translation",
    "llama",
    "local",
    "ai"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "description": "Local offline translator powered by TranslateGemma",
  "dependencies": {
    "adm-zip": "^0.5.17",
    "fast-xml-parser": "^5.7.1",
    "languagedetect": "^2.0.0",
    "node-llama-cpp": "^3.18.1",
    "pdfjs-dist": "^5.6.205",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.antigravity.translategemma",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "afterPack": "scripts/sign-extra-binaries.js",
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis-web",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "signExts": [
        ".node"
      ]
    },
    "nsis": {
      "guid": "com.antigravity.translategemma.v2",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TranslateGemma"
    },
    "linux": {
      "target": "AppImage"
    },
    "extraResources": [
      "models/**/*",
      "bin/**/*"
    ]
  }
}
